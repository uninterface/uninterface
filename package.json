{
  "name": "@uninterface/uninterface",
  "version": "0.0.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uninterface/uninterface.git"
  },
  "type": "module",
  "files": [
    "capabilities.json",
    "docs/",
    "src/"
  ],
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "test": "npm run build && node --test --test-isolation=none tests/core.test.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./capabilities.json": "./capabilities.json",
    "./backend": "./src/backend/index.ts",
    "./responsive": "./src/environment/index.ts",
    "./theme": "./src/presentation/index.ts",
    "./style.css": "./src/style.css",
    "./setup": "./src/setup/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./icons": "./src/icons/index.ts",
    "./vite": {
      "types": "./src/build/index.d.mts",
      "import": "./src/build/index.mjs"
    },
    "./vite/client": "./src/build/client.d.ts",
    "./vue-router": "./src/navigation/vue-router-index.ts"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue": "3.5.43",
    "vue-router": "4.6.4",
    "vue-tsc": "3.1.1"
  },
  "peerDependencies": {
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "vite": "^7.3.7"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
